{
  "page": "home",
  "purpose": "Show last score, unit familiarity, weak-unit review entry, and start test actions.",
  "responsivePolicy": {
    "mobile": {
      "breakpoint": "<768px",
      "layout": "single-column",
      "chartMode": "compact-donut",
      "ctaPlacement": "sticky-bottom-bar",
      "touchTargetsMinHeightPx": 48,
      "notes": [
        "Keep one primary action visible.",
        "Collapse secondary analytics into accordions.",
        "Use large cards and generous vertical spacing."
      ]
    },
    "tablet": {
      "breakpoint": "768px-1023px",
      "layout": "two-column",
      "chartMode": "mid-size-donut",
      "ctaPlacement": "inline-panel",
      "touchTargetsMinHeightPx": 44,
      "notes": [
        "Split summary and analytics into balanced columns.",
        "Preserve readable chart labels without dense tables."
      ]
    },
    "desktop": {
      "breakpoint": ">=1024px",
      "layout": "three-column",
      "chartMode": "expanded-donut",
      "ctaPlacement": "top-right-and-sidebar",
      "touchTargetsMinHeightPx": 40,
      "notes": [
        "Use a prominent dashboard header and side rail.",
        "Expose review shortcuts alongside analytics."
      ]
    }
  },
