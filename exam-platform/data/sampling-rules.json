{
  "testModes": {
    "diagnostic20": {
      "questionCount": 20,
      "timeLimitMinutes": 30,
      "answersHiddenUntilSubmit": true,
      "goal": "Measure current familiarity and mis-concept patterns before revealing answer keys."
    },
    "formal50": {
      "questionCount": 50,
      "availableAfterAttempts": 100,
      "goal": "Move to formal testing once the user has enough practice history."
    }
  },
  "selectionPolicy": {
    "first50Attempts": {
      "unseenQuestionWeight": "equal",
      "subjectWeight": "uniform across subjects",
      "repeatQuestionPenalty": "strong",
      "goal": "Keep exposure even while the bank is still being learned."
    },
    "after50Attempts": {
      "unseenQuestionWeight": "moderate",
      "subjectWeight": "inverse_to_recent_accuracy",
      "repeatQuestionPenalty": "strong",
      "weakUnitBoost": "enabled",
      "goal": "Bias sampling toward weak units without starving the rest of the bank."
    },
    "after100Attempts": {
      "questionCount": 50,
      "mode": "formal"
    }
  },
  "samplingSteps": [
    "Build an eligible pool from all question sets for the current mode.",
    "Exclude questions answered very recently unless the pool is too small.",
    "Weight each question by unit familiarity, question exposure count, and recent correctness.",
    "Sample without replacement for the current session.",
    "Store the final sample order and lock it for the session.",
    "Do not expose answer keys before the user submits the session."
  ],
  "logging": {
    "readingTimeSeconds": true,
    "answerChangeHistory": true,
    "firstAnswerTimestamp": true,
    "finalAnswerTimestamp": true,
    "perQuestionDuration": true
  },
